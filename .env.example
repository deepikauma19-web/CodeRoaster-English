# =============================================================
# Code Roaster - environment template
# Copy to .env and replace placeholders. NEVER commit .env.
# =============================================================

# --- Runtime ---
# development | test | production
ENVIRONMENT=development
# Set to true in production (HTTPS) so auth cookies are Secure
COOKIE_SECURE=false

# --- Postgres (used by docker-compose to create the DB) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=assignment_roaster

# --- Database ---
# Local (non-Docker) dev URL. docker-compose overrides this to point at the `db` service.
DATABASE_URL=postgresql://postgres:change-me-postgres-password@localhost:5432/assignment_roaster

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Comma-separated list of emails granted admin role
ADMIN_EMAILS=admin@example.com

# --- Google OAuth (https://console.cloud.google.com/apis/credentials) ---
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- OpenAI ---
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# --- GitHub (optional; raises rate limit 60 -> 5000 req/hr) ---
GITHUB_TOKEN=

# --- Analysis limits ---
MAX_FILES_ANALYZED=40
MAX_TOTAL_CHARS=120000

# Roasts a user can start per rolling 24 hours (failed roasts and admins are exempt; 0 = no limit)
DAILY_ROAST_LIMIT=10

# --- URLs ---
# Vite dev server is 5173; docker-compose.yml overrides to http://localhost:3000
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000

# --- Frontend (build-time, inlined by Vite) ---
VITE_API_URL=http://localhost:8000
