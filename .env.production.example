# =============================================================
# Code Roaster - PRODUCTION environment template
# On the VPS:  cd /opt/assignment-roaster && cp .env.production.example .env && chmod 600 .env
# Replace EVERY value containing CHANGE_ME (deploy.sh refuses to deploy while any remain).
# NEVER commit the real .env.
# =============================================================

# --- Public URL (used by docker-compose.prod.yml for FRONTEND_URL, PUBLIC_API_URL,
#     GOOGLE_REDIRECT_URI) ---
APP_URL=https://roaster.getvibed.tech

# --- Runtime (also forced by docker-compose.prod.yml) ---
ENVIRONMENT=production
COOKIE_SECURE=true
LOG_LEVEL=INFO

# --- Postgres (creates the DB on first start; data lives in the postgres_data volume) ---
# Use a URL-safe password because it is embedded in DATABASE_URL:
#   openssl rand -hex 32
POSTGRES_USER=roaster
POSTGRES_PASSWORD=CHANGE_ME_strong_hex_password
POSTGRES_DB=assignment_roaster
# DATABASE_URL is built by docker-compose from the POSTGRES_* values above (host "db").

# --- Auth ---
# Generate with:  openssl rand -base64 48
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_base64_48
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Comma-separated list of emails granted the admin role
ADMIN_EMAILS=admin@example.com

# --- Google OAuth (https://console.cloud.google.com/apis/credentials) ---
# Authorized JavaScript origin:  https://roaster.getvibed.tech
# Authorized redirect URI:       https://roaster.getvibed.tech/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME_google_client_secret
GOOGLE_REDIRECT_URI=https://roaster.getvibed.tech/api/v1/auth/google/callback

# --- OpenAI ---
OPENAI_API_KEY=CHANGE_ME_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# --- GitHub (optional; raises rate limit 60 -> 5000 req/hr). Leave empty if unused. ---
GITHUB_TOKEN=

# --- Analysis limits ---
MAX_FILES_ANALYZED=40
MAX_TOTAL_CHARS=120000

# Roasts a user can start per rolling 24 hours (failed roasts and admins are exempt; 0 = no limit)
DAILY_ROAST_LIMIT=10

# --- URLs (same origin: host nginx routes /api and /health to the backend) ---
FRONTEND_URL=https://roaster.getvibed.tech
PUBLIC_API_URL=https://roaster.getvibed.tech

# --- Frontend build arg (inlined by Vite at image build time) ---
VITE_API_URL=https://roaster.getvibed.tech
